{
    "properties": {
        "displayName": "Prevent Resource Creation During Decommissioning",
        "policyType": "Custom",
        "mode": "All",
        "description": "This policy prevents the creation of any resources in the subscription during decommissioning periods.",
        "metadata": {
            "version": "1.0.0",
            "category": "General"
        },
        "parameters": {
            "effect": {
                "type": "String",
                "metadata": {
                    "displayName": "Effect",
                    "description": "Enable or disable the execution of the policy"
                },
                "allowedValues": [
                    "Deny",
                    "Disabled"
                ],
                "defaultValue": "Deny"
            }
        },
        "policyRule": {
            "if": {
                "allOf": [
                    {
                        "field": "type",
                        "exists": "true"
                    }
                ]
            },
            "then": {
                "effect": "[parameters('effect')]"
            }
        }
    }
} 